# Path (on the droplet host) to the Firebase Admin SDK service-account JSON.
# docker-compose.prod.yml bind-mounts this into the container. Required —
# login fails with a 500 without it. Never commit the file itself.
FIREBASE_CREDENTIALS_HOST_PATH=/root/news-backend/secrets/firebase-service-account.json

# Deprecated — Firebase Authentication now verifies Google Sign-In too. Safe
# to leave unset.
# GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id

# Production database secret
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Server-side only. Sign up at astrojson.com; never place this key in the app.
ASTROJSON_API_KEY=replace-with-your-astrojson-key
# Emergency/provider migration switch. False makes the endpoint unavailable.
HOROSCOPE_ENABLED=true

# Daily poll admin and privacy-preserving installation hashing.
POLL_ADMIN_USERNAME=admin
POLL_ADMIN_PASSWORD=replace-with-a-long-password
POLL_SESSION_SECRET=replace-with-at-least-32-random-bytes
POLL_VOTER_HASH_SECRET=replace-with-a-different-random-secret

# ── Donations (Razorpay) ─────────────────────────────────────────────────────
# All three are backend-only and must never be shipped in the app.
#
# Key pair: Dashboard > Account & Settings > API Keys. Test-mode keys start
# rzp_test_, live keys rzp_live_. Used to mint one Payment Link per donation
# (POST /api/v1/donations/link) — a static hosted Payment Page can't carry the
# notes needed to attribute a donation, which is why keys are needed at all.
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# A value YOU choose, entered in Dashboard > Settings > Webhooks when creating
# the webhook — NOT the key secret above. Until it is set,
# POST /payments/razorpay/webhook returns 503 rather than recording
# unverified payments.
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-string
