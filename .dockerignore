# Secrets — must never be baked into the image. Keep in sync with .gitignore.
.env
.env.*
# Firebase Admin SDK service-account key(s) — reaches the container via a
# docker-compose.prod.yml bind mount instead, never baked into the image.
*firebase-adminsdk*.json

__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
.pytest_cache/
*.db
*.sqlite3
.DS_Store
logs/
*.log
.git/

# Raw device captures. Only the WebPs derived from them by
# scripts/prep_shots.py are served, so the 8 MB of source PNGs stay in git
# (for re-cropping) but never reach the production image.
app/static/img/*.png
